# ────────────────────────────────────────────────
# Rent-A-Vibe — Environment Variables
# Copy to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ────────────────────────────────────────────────
# ── Supabase ──────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_SECRET_KEY=your_supabase_secret_key
SUPABASE_JWKS_URL=your_supabase_jwks_url

# ── Razorpay ──────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_placeholder

# ── Cloudinary ────────────────────────────────────
CLOUDINARY_CLOUD_NAME=placeholder_cloud
CLOUDINARY_API_KEY=placeholder_key
CLOUDINARY_API_SECRET=placeholder_secret
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=placeholder_cloud
NEXT_PUBLIC_CLOUDINARY_UPLOAD_PRESET=rent-a-vibe-kyc

# ── App Config ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Rent-A-Vibe

# ── Security Deposit (in paise — 200000 = ₹2000) ─
SECURITY_DEPOSIT_PAISE=200000


